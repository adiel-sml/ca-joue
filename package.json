{
  "name": "ca-joue",
  "version": "1.0.0",
  "private": true,
  "description": "Douze jeux de soirée sur un seul téléphone : Mimes, Mot interdit, Time's Up, Quiz, Action ou Vérité, Je n'ai jamais, Tu préfères, La Bombe, 2 vérités 1 mensonge, Jeu mystère, Undercover, Loup-garou.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run cap:sync && cap open android",
    "ios": "npm run cap:sync && cap open ios",
    "icons": "capacitor-assets generate --android --ios --iconBackgroundColor '#16132b' --splashBackgroundColor '#16132b'"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@dicebear/core": "^9.2.2",
    "@dicebear/open-peeps": "^9.2.2",
    "@fontsource/dela-gothic-one": "^5.1.0",
    "@fontsource/figtree": "^5.1.1",
    "lucide": "^0.460.0"
  }
}
